/*
 * palse_check.ino
 *
 * スピードコントローラー（ESC）のPWMパルス幅チェックツール
 * シリアルモニタからパルス幅を変更してスピコンの反応を確認する
 *
 * 使い方:
 *   1. シリアルモニタを開く（115200bps）
 *   2. 数値を入力してパルス幅を設定（例: 1500）
 *   3. '+' or '-' で10μsずつ増減
 *   4. 'u' or 'd' で100μsずつ増減
 *   5. 's' で停止位置（1500μs）にリセット
 *   6. 'a' で自動スキャンモード開始
 *   7. 'q' で自動スキャン停止
 */

#include <Servo.h>

// ============================================================================
// 設定
// ============================================================================
const uint8_t ESC_PIN = 10;       // ESC接続ピン
const uint16_t ESC_MIN = 1000;   // 最小パルス幅（μs）
const uint16_t ESC_MAX = 2000;   // 最大パルス幅（μs）
const uint16_t ESC_STOP = 1500;  // 停止パルス幅（μs）

// 自動スキャン設定
const uint16_t SCAN_START = 1000;  // スキャン開始値
const uint16_t SCAN_END = 2000;    // スキャン終了値
const uint16_t SCAN_STEP = 10;     // スキャンステップ
const unsigned long SCAN_INTERVAL = 500;  // 各値の保持時間（ms）

// ============================================================================
// グローバル変数
// ============================================================================
Servo escController;
uint16_t currentPulse = ESC_STOP;
bool autoScanMode = false;
uint16_t scanPulse = SCAN_START;
unsigned long lastScanTime = 0;

// ============================================================================
// セットアップ
// ============================================================================
void setup() {
    Serial.begin(115200);
    while (!Serial) {
        ; // シリアル接続待ち
    }

    escController.attach(ESC_PIN);
    escController.writeMicroseconds(ESC_STOP);

    printHelp();
    printCurrentPulse();
}

// ============================================================================
// メインループ
// ============================================================================
void loop() {
    // 自動スキャンモード
    if (autoScanMode) {
        unsigned long now = millis();
        if (now - lastScanTime >= SCAN_INTERVAL) {
            lastScanTime = now;

            escController.writeMicroseconds(scanPulse);
            Serial.print("SCAN: ");
            Serial.print(scanPulse);
            Serial.println(" us");

            scanPulse += SCAN_STEP;
            if (scanPulse > SCAN_END) {
                autoScanMode = false;
                scanPulse = SCAN_START;
                escController.writeMicroseconds(ESC_STOP);
                Serial.println("\n=== Auto scan completed ===");
                Serial.println("ESC reset to STOP position (1500us)");
                printCurrentPulse();
            }
        }
    }

    // シリアル入力処理
    if (Serial.available()) {
        String input = Serial.readStringUntil('\n');
        input.trim();

        if (input.length() == 0) return;

        char cmd = input.charAt(0);

        switch (cmd) {
            case '+':
                currentPulse += 10;
                applyPulse();
                break;

            case '-':
                currentPulse -= 10;
                applyPulse();
                break;

            case 'u':
            case 'U':
                currentPulse += 100;
                applyPulse();
                break;

            case 'd':
            case 'D':
                currentPulse -= 100;
                applyPulse();
                break;

            case 's':
            case 'S':
                currentPulse = ESC_STOP;
                applyPulse();
                Serial.println("Reset to STOP position");
                break;

            case 'a':
            case 'A':
                startAutoScan();
                break;

            case 'q':
            case 'Q':
                stopAutoScan();
                break;

            case 'h':
            case 'H':
            case '?':
                printHelp();
                break;

            default:
                // 数値として解釈を試みる
                int pulse = input.toInt();
                if (pulse >= ESC_MIN && pulse <= ESC_MAX) {
                    currentPulse = pulse;
                    applyPulse();
                } else if (pulse != 0) {
                    Serial.print("Error: Pulse must be between ");
                    Serial.print(ESC_MIN);
                    Serial.print(" and ");
                    Serial.println(ESC_MAX);
                }
                break;
        }
    }
}

// ============================================================================
// ヘルパー関数
// ============================================================================
void applyPulse() {
    // 範囲チェック
    if (currentPulse < ESC_MIN) currentPulse = ESC_MIN;
    if (currentPulse > ESC_MAX) currentPulse = ESC_MAX;

    escController.writeMicroseconds(currentPulse);
    printCurrentPulse();
}

void printCurrentPulse() {
    Serial.print("Current pulse: ");
    Serial.print(currentPulse);
    Serial.print(" us (");
    Serial.print(currentPulse / 1000.0, 3);
    Serial.println(" ms)");

    // 停止位置からの差分を表示
    int diff = currentPulse - ESC_STOP;
    if (diff > 0) {
        Serial.print("  -> +");
        Serial.print(diff);
        Serial.println(" us from STOP (Forward direction)");
    } else if (diff < 0) {
        Serial.print("  -> ");
        Serial.print(diff);
        Serial.println(" us from STOP (Reverse direction)");
    } else {
        Serial.println("  -> STOP position");
    }
}

void printHelp() {
    Serial.println("\n========================================");
    Serial.println("  ESC Pulse Width Checker");
    Serial.println("========================================");
    Serial.println("Commands:");
    Serial.println("  [number]  Set pulse width directly (e.g., 1500)");
    Serial.println("  +         Increase by 10us");
    Serial.println("  -         Decrease by 10us");
    Serial.println("  u         Increase by 100us");
    Serial.println("  d         Decrease by 100us");
    Serial.println("  s         Stop (reset to 1500us)");
    Serial.println("  a         Start auto scan mode");
    Serial.println("  q         Quit auto scan mode");
    Serial.println("  h/?       Show this help");
    Serial.println("----------------------------------------");
    Serial.print("ESC Pin: ");
    Serial.println(ESC_PIN);
    Serial.print("Range: ");
    Serial.print(ESC_MIN);
    Serial.print(" - ");
    Serial.print(ESC_MAX);
    Serial.println(" us");
    Serial.println("========================================\n");
}

void startAutoScan() {
    autoScanMode = true;
    scanPulse = SCAN_START;
    lastScanTime = millis();

    Serial.println("\n=== Auto scan started ===");
    Serial.print("Scanning from ");
    Serial.print(SCAN_START);
    Serial.print(" to ");
    Serial.print(SCAN_END);
    Serial.print(" us (step: ");
    Serial.print(SCAN_STEP);
    Serial.println(" us)");
    Serial.println("Press 'q' to stop\n");
}

void stopAutoScan() {
    autoScanMode = false;
    escController.writeMicroseconds(ESC_STOP);
    currentPulse = ESC_STOP;

    Serial.println("\n=== Auto scan stopped ===");
    Serial.println("ESC reset to STOP position (1500us)");
    printCurrentPulse();
}
